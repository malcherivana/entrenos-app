# Configure estes valores em Vercel → Project → Settings → Environment Variables.
# Gere ADMIN_PASSWORD_HASH, ADMIN_PASSWORD_SALT e SESSION_SECRET localmente com:
#   node scripts/hash-admin-password.cjs
ADMIN_USERNAME=
ADMIN_PASSWORD_SALT=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Conecte um Redis compatível com Upstash e informe os valores REST do provedor.
# O app também aceita os nomes KV_REST_API_URL e KV_REST_API_TOKEN, se já existirem.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
